{
  "manifest_version": 3,
  "name": "X-Ray Semantic Projector",
  "version": "1.0",
  "description": "Injects IDs and syncs DOM with X-Ray Agentd.",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "X-Ray: Capture Snapshot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
